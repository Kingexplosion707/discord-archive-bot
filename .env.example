# ---- Required -------------------------------------------------------------

# Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# With Developer Mode on in Discord: right-click the server > Copy Server ID
DISCORD_GUILD_ID=

# Right-click your own name > Copy User ID
DISCORD_OWNER_ID=

# Filled in by install.sh. Encrypts the saved Google login.
ENCRYPTION_KEY=

# ---- Optional -------------------------------------------------------------

# Google Photos album that everything goes into
GOOGLE_ALBUM_NAME=Discord Archive

# Posts by anyone with this role are not saved
SKIP_ROLE_NAME=clankers

# Time zone for the dates written into photos
TIMEZONE=America/Toronto

# Full check of the server each day, in TIMEZONE (24-hour time)
SYNC_TIME=19:00

# Channel IDs to leave out, comma-separated. Threads follow their parent channel.
SKIP_CHANNEL_IDS=

# Age-restricted channels are left out unless this is true
SCAN_NSFW_CHANNELS=false

# Files bigger than this are skipped
MAX_DOWNLOAD_MB=500

# ---- Watch tracker, Stremio addon and lyrics page ---------------------------

# Public https address of the bot's web page (your Cloudflare Tunnel hostname).
# Stremio addon links and the word-by-word lyrics page are built from this.
PUBLIC_URL=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install token
TUNNEL_TOKEN=

# Set to "tunnel" to start the Cloudflare tunnel next to the bot
COMPOSE_PROFILES=

# Port the web page listens on inside the container
WEB_PORT=8080
